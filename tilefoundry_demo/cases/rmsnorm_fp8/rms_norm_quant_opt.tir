from __future__ import annotations

from tilefoundry.dsl import *
from tilefoundry_nvidia import CudaTarget


@module(
    entry="rms_norm_quant",
    target=CudaTarget("nvidia.h200_sxm"),
    topologies=(Topology("cta", 132), Topology("thread", 256),),
)
class FusedScheduled:
    @prim_func(target=CudaTarget("nvidia.h200_sxm"), output_count=2)
    def rms_norm_quant(
        a: Tensor[(264, 56, 128), "bf16"], gamma: ConstTensor[(1, 56, 128), "bf16"], out: Tensor[(264, 56, 128), "fp8e4m3"], out_1: Tensor[(264, 56, 1), "f32"]
    ):
        with Mesh((Topology("cta", 132),), layout=(132,), names=("tile",)) as cta:
            with Mesh(
                (Topology("thread", 256),), layout=(2, 4, 32), names=("x", "y", "t")
            ) as scope:
                T.fill(out, 0.0)
                held_dst = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128),
                        "bf16",
                        (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4),
                        "rmem",
                    ]
                )
                value = T.tensor_view(
                    T.ptr_of(a[cta.tile * 2:cta.tile * 2 + 1, 0:0 + 1, 0:0 + 1]),
                    layout=(2, 56, 128),
                    shape=(2, 56, 128),
                )
                dst_view = T.tensor_view(
                    T.ptr_of(held_dst[0:0 + 2, 0:0 + 56, 0:0 + 128]),
                    layout=(2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4),
                    shape=(2, 56, 128),
                )
                T.copy(value, dst_view)
                rows = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128), "f32", (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4), "rmem"
                    ]
                )
                src_view = T.tensor_view(
                    T.ptr_of(held_dst[0:0 + 2, 0:0 + 56, 0:0 + 128]),
                    layout=(2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4),
                    shape=(2, 56, 128),
                )
                T.cast(src_view, rows, dtype="f32")
                value_1 = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128), "f32", (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4), "rmem"
                    ]
                )
                T.unary(rows, value_1, kind=UnaryKind.SQUARE)
                mean_dst = T.alloc_tensor(
                    tensor_type=Tensor[(2, 1, 1), "f32", (2 @ scope.x, 1, 1, 1, 1), "rmem"]
                )
                dst_view_1 = T.tensor_view(
                    T.ptr_of(mean_dst[0:0 + 2, 0:0 + 1, 0:0 + 1]),
                    layout=(2 @ scope.x, 1, 1, 1, 1),
                    shape=(2, 1, 1),
                )
                T.reduce(value_1, dst_view_1, axes=(1, 2), keepdim=True, kind=ReduceKind.MEAN)
                value_2 = T.alloc_tensor(
                    tensor_type=Tensor[(2, 1, 1), "f32", (2 @ scope.x, 1, 1, 1, 1), "rmem"]
                )
                scalar = T.alloc_tensor(tensor_type=Tensor[(), "f32", "rmem"])
                T.fill(scalar, 1e-06)
                lhs_view = T.tensor_view(
                    T.ptr_of(mean_dst[0:0 + 2, 0:0 + 1, 0:0 + 1]),
                    layout=(2 @ scope.x, 1, 1, 1, 1),
                    shape=(2, 1, 1),
                )
                T.binary(lhs_view, scalar, value_2, kind=BinaryKind.ADD)
                value_3 = T.alloc_tensor(
                    tensor_type=Tensor[(2, 1, 1), "f32", (2 @ scope.x, 1, 1, 1, 1), "rmem"]
                )
                T.unary(value_2, value_3, kind=UnaryKind.RSQRT)
                value_4 = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128), "f32", (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4), "rmem"
                    ]
                )
                T.binary(rows, value_3, value_4, kind=BinaryKind.MUL)
                value_5 = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128),
                        "bf16",
                        (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4),
                        "rmem",
                    ]
                )
                T.cast(value_4, value_5, dtype="bf16")
                scaling_dst = T.alloc_tensor(
                    tensor_type=Tensor[
                        (1, 56, 128), "bf16", (1, 4 @ scope.y, 14, 32 @ scope.t, 4), "rmem"
                    ]
                )
                dst_view_2 = T.tensor_view(
                    T.ptr_of(scaling_dst[0:0 + 1, 0:0 + 56, 0:0 + 128]),
                    layout=(1, 4 @ scope.y, 14, 32 @ scope.t, 4),
                    shape=(1, 56, 128),
                )
                T.copy(gamma, dst_view_2)
                normed = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128),
                        "bf16",
                        (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4),
                        "rmem",
                    ]
                )
                rhs_view = T.tensor_view(
                    T.ptr_of(scaling_dst[0:0 + 1, 0:0 + 56, 0:0 + 128]),
                    layout=(1, 4 @ scope.y, 14, 32 @ scope.t, 4),
                    shape=(1, 56, 128),
                )
                T.binary(value_5, rhs_view, normed, kind=BinaryKind.MUL)
                blocks = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128), "f32", (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4), "rmem"
                    ]
                )
                T.cast(normed, blocks, dtype="f32")
                scale_dst = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 1), "f32", (2 @ scope.x, 4 @ scope.y, 14, 1, 1), "rmem"
                    ]
                )
                dst_view_3 = T.tensor_view(
                    T.ptr_of(scale_dst[0:0 + 2, 0:0 + 56, 0:0 + 1]),
                    layout=(2 @ scope.x, 4 @ scope.y, 14, 1, 1),
                    shape=(2, 56, 1),
                )
                T.reduce(blocks, dst_view_3, axes=(2,), keepdim=True, kind=ReduceKind.ABS_MAX)
                scale = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 1), "f32", (2 @ scope.x, 4 @ scope.y, 14, 1, 1), "rmem"
                    ]
                )
                scalar_1 = T.alloc_tensor(tensor_type=Tensor[(), "f32", "rmem"])
                T.fill(scalar_1, 0.002232142857142857)
                lhs_view_1 = T.tensor_view(
                    T.ptr_of(scale_dst[0:0 + 2, 0:0 + 56, 0:0 + 1]),
                    layout=(2 @ scope.x, 4 @ scope.y, 14, 1, 1),
                    shape=(2, 56, 1),
                )
                T.binary(lhs_view_1, scalar_1, scale, kind=BinaryKind.MUL)
                value_6 = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128), "f32", (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4), "rmem"
                    ]
                )
                T.binary(blocks, scale, value_6, kind=BinaryKind.DIV)
                value_7 = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128), "f32", (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4), "rmem"
                    ]
                )
                T.clamp(value_6, value_7, min_val=-448.0, max_val=448.0)
                quant = T.alloc_tensor(
                    tensor_type=Tensor[
                        (2, 56, 128),
                        "fp8e4m3",
                        (2 @ scope.x, 4 @ scope.y, 14, 32 @ scope.t, 4),
                        "rmem",
                    ]
                )
                T.cast(value_7, quant, dtype="fp8e4m3")
                window = T.tensor_view(
                    T.ptr_of(out[cta.tile * 2:cta.tile * 2 + 2, 0:0 + 56, 0:0 + 128]),
                    layout=(2, 56, 128),
                    shape=(2, 56, 128),
                )
                T.copy(quant, window)
                T.fill(out_1, 0.0)
                window_1 = T.tensor_view(
                    T.ptr_of(out_1[cta.tile * 2:cta.tile * 2 + 2, 0:0 + 56, 0:0 + 1]),
                    layout=(2, 56, 1),
                    shape=(2, 56, 1),
                )
                T.copy(scale, window_1)
